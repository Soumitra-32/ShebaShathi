# ==========================================
# ShebaShathi BD - Environment Variables
# ==========================================

# ==========================================
# LLM Configuration (optional)
# ==========================================
# Only the source-grounded copilot and the optional intake classifier use this
# provider. The complaint drafter, the document comparison and the voice input
# always stay in the browser. With no key, the copilot shows the cited source
# excerpt and intake uses the deterministic keyword router.
#
# OpenRouter (recommended):
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-3.5-sonnet      # or any other OpenRouter model id
#   LLM_API_KEY=sk-or-v1-...                   # your OpenRouter key
#
# OpenAI or any other OpenAI-compatible endpoint:
#   LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_API_BASE=https://api.openai.com/v1
# Optional comma-separated fallbacks used when the primary model is rate-limited or unavailable
LLM_MODEL_FALLBACKS=google/gemini-2.5-flash,openai/gpt-4o-mini

# API key for your LLM provider
LLM_API_KEY=

# Optional OpenRouter attribution headers (shown in the provider dashboard)
LLM_APP_TITLE=ShebaShathi BD
LLM_HTTP_REFERER=http://localhost:3000

# ==========================================
# Server
# ==========================================
# Host and port for the FastAPI backend
HOST=0.0.0.0
PORT=8000

# Debug mode
DEBUG=false

# ==========================================
# CORS
# ==========================================
# Comma-separated allowed origins (frontend URL)
# Example: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ==========================================
# RAG / Vector Store
# ==========================================
# ChromaDB persistence directory. A relative path is resolved against the
# repository root, not the current working directory.
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Top-K chunks to retrieve
RAG_TOP_K=5

# Minimum similarity score threshold
RAG_MIN_SCORE=0.35
# Warm Chroma and the embedding model during startup (false = lazy warmup)
WARM_RETRIEVAL=true

# ==========================================
# Abuse controls (costly public endpoints)
# ==========================================
# Process-local sliding window. For multiple instances use a shared store.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
INTAKE_RATE_LIMIT_PER_MINUTE=60
