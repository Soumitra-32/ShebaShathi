# ==========================================
# ShebaShathi BD - Environment Variables
# ==========================================

# ==========================================
# LLM Configuration
# ==========================================
# Optional OpenAI-compatible generation API. With no key, RAG uses source excerpts.
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=https://api.openai.com/v1

# API key for your LLM provider
LLM_API_KEY=

# ==========================================
# Server
# ==========================================
# Host and port for the FastAPI backend
HOST=0.0.0.0
PORT=8000

# Debug mode
DEBUG=false

# ==========================================
# CORS
# ==========================================
# Comma-separated allowed origins (frontend URL)
# Example: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ==========================================
# RAG / Vector Store
# ==========================================
# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Top-K chunks to retrieve
RAG_TOP_K=5

# Minimum similarity score threshold
RAG_MIN_SCORE=0.35
