# ==========================================
# ShebaShathi BD - Environment Variables
# ==========================================

# ==========================================
# LLM Configuration (optional)
# ==========================================
# Only the source-grounded copilot and the optional intake classifier use this
# provider. The complaint drafter, the document comparison and the voice input
# always stay in the browser. With no key, the copilot shows the cited source
# excerpt and intake uses the deterministic keyword router.
#
# OpenRouter (recommended):
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   LLM_MODEL=anthropic/claude-3.5-sonnet      # or any other OpenRouter model id
#   LLM_API_KEY=sk-or-v1-...                   # your OpenRouter key
#
# OpenAI or any other OpenAI-compatible endpoint:
#   LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_API_BASE=https://api.openai.com/v1
# Optional comma-separated fallbacks used when the primary model is rate-limited or unavailable
LLM_MODEL_FALLBACKS=google/gemini-2.5-flash,openai/gpt-4o-mini

# API key for your LLM provider
LLM_API_KEY=

# Optional OpenRouter attribution headers (shown in the provider dashboard)
LLM_APP_TITLE=ShebaShathi BD
LLM_HTTP_REFERER=http://localhost:3000

# ==========================================
# Server
# ==========================================
# Host and port for the FastAPI backend
HOST=0.0.0.0
PORT=8000

# Debug mode
DEBUG=false

# ==========================================
# CORS
# ==========================================
# Comma-separated allowed origins (frontend URL)
# Example: http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# ==========================================
# RAG / Vector Store
# ==========================================
# ChromaDB persistence directory. A relative path is resolved against the
# repository root, not the current working directory.
CHROMA_PERSIST_DIR=./.chroma
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Bounded cache for repeated query embeddings. Keys are SHA-256 digests, so a
# user question is not retained as text. Passages/indexing batches are not cached.
ML_EMBEDDING_CACHE_SIZE=512

# Top-K chunks to retrieve
RAG_TOP_K=5

# Minimum similarity score threshold
RAG_MIN_SCORE=0.35

# Semantic fallback after the deterministic relevance vocabulary check.
# It only broadens scope; lexical matches always run first.
SEMANTIC_SCOPE_ENABLED=true
SEMANTIC_SCOPE_MIN_SCORE=0.82
SEMANTIC_SCOPE_MIN_MARGIN=0.01

# Without an LLM key, show an extractive excerpt only when it shares a task
# word with the question or the retrieval score is at least this high.
EXTRACTIVE_MIN_SCORE=0.86
# Warm Chroma and the embedding model during startup (false = lazy warmup)
WARM_RETRIEVAL=true

# ==========================================
# Abuse controls (costly public endpoints)
# ==========================================
# sqlite = hashed file-backed window shared by worker processes on one host;
# redis = opt-in shared window for a genuinely multi-host deployment;
# memory = original process-local window.
RATE_LIMIT_STORE=sqlite
RATE_LIMIT_DB_PATH=.state/rate_limits.db
# Required only when RATE_LIMIT_STORE=redis. Never commit a real credential.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=shebashathi:rate-limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
INTAKE_RATE_LIMIT_PER_MINUTE=60

# Proxy trust is opt-in. Set true only when the service is reachable only
# through a trusted reverse proxy; TRUSTED_PROXY_IPS should list its address
# or CIDR (comma-separated) so a direct caller cannot spoof X-Forwarded-For.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=
